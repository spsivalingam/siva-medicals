---
import OpenBadge from "./OpenBadge.astro";
import { site } from "../data/site";
import { t, type Locale } from "../i18n/utils";
import { formatTime, weekRows } from "../lib/hours";

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const rows = weekRows(site.hours);
---
<section id="hours" aria-labelledby="hours-title" class="bg-slate-50">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
  <div class="flex flex-wrap items-center gap-3">
    <h2 id="hours-title" class="text-2xl font-bold sm:text-3xl">{s.hours.title}</h2>
    <OpenBadge locale={locale} testid="open-badge" />
  </div>
  <table data-testid="hours-table" class="mt-6 w-full max-w-md text-left">
    <tbody>
      {rows.map((row) => (
        <tr class="border-b border-slate-200">
          <th scope="row" class="py-2 pr-4 font-normal text-slate-900">{s.hours.days[row.day]}</th>
          <td class="py-2 text-slate-700">
            {row.slots.length === 0
              ? s.hours.closed
              : row.slots.map((h) => (
                  <span class="block">{formatTime(h.open, locale)} – {formatTime(h.close, locale)}</span>
                ))}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="mt-4 text-base text-slate-600">{s.hours.note}</p>
  </div>
</section>
